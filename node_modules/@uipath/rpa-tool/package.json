{
  "name": "@uipath/rpa-tool",
  "version": "1.203.1",
  "description": "Tool for creating and managing UiPath RPA projects",
  "keywords": [
    "uipcli-tool",
    "rpa",
    "studio"
  ],
  "type": "module",
  "main": "./dist/tool.js",
  "exports": {
    ".": "./dist/tool.js",
    "./packager-tool": "./dist/packager-tool.js",
    "./executor-tool": "./dist/executor-tool.js"
  },
  "private": false,
  "maintainers": [
    "vlad-uipath",
    "andrei.balint",
    "andrei.singeorzan"
  ],
  "bin": {
    "rpa-tool": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UiPath/Studio.git",
    "directory": "RpaTool/rpa-tool"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "bunx tsc --noEmit && bun build ./src/packager-tool.ts --outdir dist --format esm --target node --external applicationinsights && bun build ./src/executor-tool.ts --outdir dist --format esm --target node --external applicationinsights && bun build ./src/tool.ts --outdir dist --format esm --target node --external '*/packager-tool.js' --external applicationinsights && bun build ./src/index.ts --outdir dist --format esm --target node --external '*/tool.js' --external applicationinsights",
    "package": "bun run build && bun pm pack",
    "generate-docs": "bun run scripts/generate-docs.ts",
    "bump-uipath-alpha": "bun run scripts/bump-uipath-alpha.ts",
    "bump-uipath-release": "bun run scripts/bump-uipath-release.ts",
    "bump-uipath-stable": "bun run scripts/bump-uipath-stable.ts",
    "test": "bun test",
    "lint": "bunx @biomejs/biome check src scripts",
    "lint:fix": "bunx @biomejs/biome check --write src scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@uipath/auth": "1.203.0-dev.8641",
    "@uipath/common": "1.203.0-dev.8641",
    "@uipath/coreipc": "2.5.2",
    "@uipath/filesystem": "1.203.0-dev.8641",
    "@uipath/packager-tool-workflowcompiler": "1.203.0-dev.8641",
    "@uipath/project-executor": "1.203.0-dev.8641",
    "@uipath/project-packager": "1.203.0-dev.8641",
    "@uipath/solution-sdk": "1.203.0-dev.8641",
    "@uipath/solutionpackager-tool-core": "1.203.0-dev.8641",
    "camelcase-keys": "^10.0.2",
    "commander": "^14.0.3",
    "fflate": "^0.8.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@uipath/studio-helm-win32-x64": "1.203.1",
    "@uipath/studio-helm-win32-arm64": "1.203.1",
    "@uipath/studio-helm-linux-x64": "1.203.1",
    "@uipath/studio-helm-linux-arm64": "1.203.1",
    "@uipath/studio-helm-darwin-x64": "1.203.1",
    "@uipath/studio-helm-darwin-arm64": "1.203.1"
  }
}
