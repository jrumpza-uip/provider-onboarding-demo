#!/bin/sh
# Prefer the dotnet muxer under DOTNET_ROOT when the caller sets it (e.g.
# `uip rpa` points it at the Robot-bundled .NET 8). Falls back to PATH so a
# plain `UiPath.Studio.Helm` invocation still works in dev. UV-14659.
DIR="$(cd "$(dirname "$0")" && pwd)"
exec "${DOTNET_ROOT:+$DOTNET_ROOT/}dotnet" "$DIR/UiPath.Studio.Helm.dll" "$@"
