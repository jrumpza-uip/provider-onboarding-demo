#!/bin/sh
# Prefer the dotnet muxer under DOTNET_ROOT when the caller sets it (e.g.
# `uip rpa` points it at the Robot-bundled .NET 8), and fall back to PATH so a
# plain `UiPath.WorkflowCompiler` invocation still works in dev — same rationale
# as UiPath.Studio.Helm.sh (UV-14659). A GUI-launched Studio inherits launchd's
# minimal PATH, so bare `dotnet` is not reliably resolvable there.
DIR="$(cd "$(dirname "$0")" && pwd)"
exec "${DOTNET_ROOT:+$DOTNET_ROOT/}dotnet" "$DIR/UiPath.WorkflowCompiler.dll" "$@"
